{
  "name": "@menubuddy/design-tokens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Brisolo brand tokens shared by /site and /app (Tailwind v4 theme, fonts, logo).",
  "exports": {
    ".": "./src/tokens.ts",
    "./theme.css": "./theme.css",
    "./fonts.css": "./fonts.css",
    "./assets/*": "./assets/*"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "check": "node scripts/build.ts --check && tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "~5.9.3"
  }
}

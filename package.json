{
  "name": "menubuddy",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "site",
    "app"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev:site": "npm run dev -w @menubuddy/site",
    "build:site": "npm run build -w @menubuddy/site",
    "build:tokens": "npm run build -w @menubuddy/design-tokens",
    "check": "npm run check --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:site:test": "SITE_URL=https://menubuddy-site.sonuyou19.workers.dev PUBLIC_SITE_NOINDEX=true npm run build -w @menubuddy/site",
    "dev:app": "npm run dev -w @menubuddy/app",
    "build:app": "npm run build -w @menubuddy/app",
    "build:app:test": "npm run build -w @menubuddy/app"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "wrangler": "~4.149.0"
  }
}

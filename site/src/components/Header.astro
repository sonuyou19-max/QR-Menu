---
import Logo from "./Logo.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { getDictionary, localePath, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  path: string;
}
const { lang, path } = Astro.props;
const t = getDictionary(lang);
const home = localePath(lang, "/");
const links = [
  { href: `${home}#how`, label: t.nav.howItWorks },
  { href: `${home}#demo`, label: t.nav.demo },
  { href: `${home}#pricing`, label: t.nav.pricing },
  { href: `${home}#faq`, label: t.nav.faq },
];
---

<a
  href="#main"
  class="sr-only z-50 rounded-control bg-ink px-4 py-2 text-canvas focus:not-sr-only focus:fixed focus:top-2 focus:left-2"
>
  {t.nav.skipToContent}
</a>
<header class="sticky top-0 z-40 border-b border-line/70 bg-canvas/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-3 px-4">
    <a href={home} aria-label={t.nav.home} class="mr-auto shrink-0">
      <Logo compact />
    </a>
    <nav aria-label={t.nav.main} class="hidden lg:block">
      <ul class="flex gap-1 text-[15px] font-medium">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              class="rounded-control px-3 py-2 text-ink-muted hover:text-ink"
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <LanguageSwitcher lang={lang} path={path} label={t.nav.language} />
    <a
      href={localePath(lang, "/demo")}
      data-cta="header"
      class="btn-primary min-h-10 px-4 py-2 text-[15px]"
    >
      <span class="sm:hidden">{t.nav.bookDemoShort}</span>
      <span class="hidden sm:inline">{t.nav.bookDemo}</span>
    </a>
  </div>
</header>

---
// Static preview of the guest experience. Phase 0.3 replaces the phones with the interactive DemoPhone island.
import Check from "@lucide/astro/icons/check";
import PhoneFrame from "../phone/PhoneFrame.astro";
import MenuScreen from "../phone/MenuScreen.astro";
import StaffScreen from "../phone/StaffScreen.astro";
import { getDictionary, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}
const t = getDictionary(Astro.props.lang);
---

<section
  id="demo"
  aria-labelledby="demo-title"
  class="overflow-hidden bg-oat-900 px-4 py-20 text-oat-50 sm:py-28"
>
  <div class="mx-auto grid max-w-6xl items-center gap-14 lg:grid-cols-2">
    <div>
      <p class="mb-3 text-sm font-semibold tracking-wide text-mustard-300 uppercase">
        {t.demo.eyebrow}
      </p>
      <h2 id="demo-title" class="text-3xl font-semibold sm:text-5xl">
        {t.demo.title}
      </h2>
      <p class="mt-5 text-lg text-oat-200">{t.demo.text}</p>
      <ul class="mt-8 space-y-3">
        {t.demo.points.map((point) => (
          <li class="flex gap-3">
            <Check
              class="mt-0.5 size-5 shrink-0 text-mustard-300"
              aria-hidden="true"
            />
            <span>{point}</span>
          </li>
        ))}
      </ul>
      <p class="mt-8 text-sm text-oat-300">{t.demo.sampleNote}</p>
    </div>
    <div class="flex justify-center gap-4 sm:gap-6">
      <div class="w-full max-w-[17rem] -rotate-2 sm:w-1/2">
        <PhoneFrame label={t.hero.phoneLabel} tone="onDark">
          <MenuScreen lang="en" categories={[0, 2]} />
        </PhoneFrame>
      </div>
      <div class="mt-12 hidden w-1/2 max-w-[17rem] rotate-2 sm:block">
        <PhoneFrame label={t.demo.staffScreenLabel} tone="onDark">
          <StaffScreen lang="en" />
        </PhoneFrame>
      </div>
    </div>
  </div>
</section>

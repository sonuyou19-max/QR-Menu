---
// Live demo (CLAUDE.md 4.6, Demo A): interactive sample menu + QR code / full-screen link.
// Once the guest menu exists, the island is replaced by an iframe of app.menubuddy.be/m/demo.
import Check from "@lucide/astro/icons/check";
import Maximize from "@lucide/astro/icons/maximize-2";
import QRCode from "qrcode";
import PhoneFrame from "../phone/PhoneFrame.astro";
import DemoPhone from "../demo/DemoPhone";
import { getDictionary, localePath, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getDictionary(lang);
const fullscreenHref = localePath(lang, "/menu-demo");
const qrSvg = await QRCode.toString(new URL(fullscreenHref, Astro.site).href, {
  type: "svg",
  margin: 0,
  errorCorrectionLevel: "M",
  color: { dark: "#241e19", light: "#ffffff" },
});
---

<section
  id="demo"
  aria-labelledby="demo-title"
  class="overflow-hidden bg-oat-900 px-4 py-20 text-oat-50 sm:py-28"
>
  <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-2">
    <div>
      <p class="mb-3 text-sm font-semibold tracking-wide text-mustard-300 uppercase">
        {t.demo.eyebrow}
      </p>
      <h2 id="demo-title" class="text-3xl font-semibold sm:text-5xl">
        {t.demo.title}
      </h2>
      <p class="mt-5 text-lg text-oat-200">{t.demo.text}</p>
      <ul class="mt-8 space-y-3">
        {t.demo.points.map((point) => (
          <li class="flex gap-3">
            <Check
              class="mt-0.5 size-5 shrink-0 text-mustard-300"
              aria-hidden="true"
            />
            <span>{point}</span>
          </li>
        ))}
      </ul>

      <a
        href={fullscreenHref}
        data-cta="demo-fullscreen"
        class="btn mt-8 bg-mustard-400 text-oat-950 hover:bg-mustard-300 lg:hidden"
      >
        <Maximize class="size-5" aria-hidden="true" />
        {t.demo.openFullscreen}
      </a>

      <div class="mt-10 hidden items-center gap-5 rounded-card bg-oat-800 p-5 lg:flex">
        <div
          class="size-28 shrink-0 rounded-xl bg-white p-2.5 [&>svg]:size-full"
          set:html={qrSvg}
          aria-hidden="true"
        />
        <div>
          <p class="font-display text-xl font-semibold">{t.demo.qrTitle}</p>
          <p class="mt-1 text-oat-200">{t.demo.qrText}</p>
        </div>
      </div>
      <p class="mt-6 text-sm text-oat-300">{t.demo.sampleNote}</p>
    </div>

    <div class="mx-auto w-full max-w-[22rem]">
      <PhoneFrame tone="onDark">
        <DemoPhone client:visible label={t.demo.phoneLabel} />
      </PhoneFrame>
    </div>
  </div>
</section>

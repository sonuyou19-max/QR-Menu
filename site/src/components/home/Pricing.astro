---
import Check from "@lucide/astro/icons/check";
import Section from "../Section.astro";
import { annualPerMonth, perDay, plans } from "../../data/pricing";
import {
  fill,
  formatPrice,
  getDictionary,
  localePath,
  type Lang,
} from "../../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getDictionary(lang);
const price = (n: number) => formatPrice(lang, n);
const visits = (n: number) =>
  n.toLocaleString(lang === "en" ? "en-GB" : `${lang}-BE`);
---

<Section
  id="pricing"
  eyebrow={t.pricing.eyebrow}
  title={t.pricing.title}
  center
  class="bg-surface"
>
  <p class="mx-auto mt-4 max-w-xl text-lg text-ink-muted">{t.pricing.intro}</p>

  <div data-pricing data-billing="monthly" class="group mx-auto mt-8 max-w-6xl">
    <!-- Hidden until JS runs; without JS each card shows monthly with the annual price below. -->
    <div data-billing-toggle hidden class="mb-8 flex justify-center">
      <div
        role="group"
        aria-label={t.pricing.billingLabel}
        class="inline-flex rounded-full bg-oat-100 p-1"
      >
        <button
          type="button"
          data-value="monthly"
          aria-pressed="true"
          class="min-h-11 rounded-full px-5 font-semibold text-ink-muted aria-pressed:bg-surface aria-pressed:text-ink aria-pressed:shadow-sm"
        >
          {t.pricing.monthly}
        </button>
        <button
          type="button"
          data-value="annual"
          aria-pressed="false"
          class="flex min-h-11 items-center gap-2 rounded-full px-5 font-semibold text-ink-muted aria-pressed:bg-surface aria-pressed:text-ink aria-pressed:shadow-sm"
        >
          {t.pricing.annual}
          <span class="rounded-full bg-accent px-2 py-0.5 text-xs text-on-accent">
            {t.pricing.save}
          </span>
        </button>
      </div>
    </div>

    <ul class="grid gap-5 text-left lg:grid-cols-3" aria-live="polite">
      {plans.map((plan) => {
        const text = t.pricing.plans[plan.key];
        const featured = plan.key === "medium";
        return (
          <li
            class:list={[
              "flex flex-col rounded-card bg-canvas p-7 shadow-card",
              featured ? "border-2 border-ink" : "border border-line",
            ]}
          >
            <h3 class="font-display text-2xl font-semibold">{text.name}</h3>
            <p class="mt-1 font-semibold">{text.seats}</p>
            <p class="text-ink-muted">{text.who}</p>

            <div class="mt-5 group-data-[billing=annual]:hidden">
              <p class="flex items-baseline gap-2">
                <span class="font-display text-5xl font-semibold">
                  {price(plan.monthly)}
                </span>
                <span class="text-ink-muted">{t.pricing.perMonth}</span>
              </p>
              <p class="mt-2 font-semibold text-brand">
                {fill(t.pricing.perDay, { price: price(perDay(plan.monthly)) })}
              </p>
              <p class="mt-1 text-sm text-ink-muted">
                {fill(t.pricing.monthlyAlternative, {
                  price: price(plan.annual),
                })}
              </p>
            </div>
            <div class="mt-5 hidden group-data-[billing=annual]:block">
              <p class="flex items-baseline gap-2">
                <span class="font-display text-5xl font-semibold">
                  {price(plan.annual)}
                </span>
                <span class="text-ink-muted">{t.pricing.perYear}</span>
              </p>
              <p class="mt-2 font-semibold text-brand">
                {fill(t.pricing.annualEquivalent, {
                  price: price(annualPerMonth(plan.annual)),
                })}
              </p>
            </div>

            <div class="mt-auto pt-6">
              <a
                href={localePath(lang, "/demo")}
                data-cta={`pricing-${plan.key}`}
                class:list={[
                  "w-full",
                  featured ? "btn-primary" : "btn-secondary",
                ]}
              >
                {t.pricing.cta}
              </a>
            </div>
          </li>
        );
      })}
    </ul>

    <div class="mx-auto mt-10 max-w-3xl text-left">
      <h3 class="font-sans text-lg font-semibold">{t.pricing.includesTitle}</h3>
      <ul class="mt-3 grid gap-x-8 gap-y-2.5 sm:grid-cols-2">
        {t.pricing.includes.map((item) => (
          <li class="flex gap-3">
            <Check
              class="mt-0.5 size-5 shrink-0 text-success"
              aria-hidden="true"
            />
            {item}
          </li>
        ))}
      </ul>
      <p class="mt-6 text-ink-muted">
        {fill(t.pricing.sizeNote, {
          small: visits(plans[0].visitsPerMonth),
          medium: visits(plans[1].visitsPerMonth),
        })}
      </p>
      <p class="mt-2 text-sm text-ink-muted">{t.pricing.vat}</p>
      <p class="mt-4 font-medium text-herb-700">{t.pricing.pilot}</p>
    </div>
  </div>
</Section>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-pricing]")) {
    const toggle = root.querySelector<HTMLElement>("[data-billing-toggle]");
    if (!toggle) continue;
    toggle.hidden = false;
    const buttons =
      toggle.querySelectorAll<HTMLButtonElement>("button[data-value]");
    for (const button of buttons) {
      button.addEventListener("click", () => {
        root.dataset.billing = button.dataset.value;
        for (const b of buttons)
          b.setAttribute("aria-pressed", String(b === button));
      });
    }
  }
</script>

---
import Languages from "@lucide/astro/icons/languages";
import Type from "@lucide/astro/icons/type";
import BookOpen from "@lucide/astro/icons/book-open";
import Funnel from "@lucide/astro/icons/funnel";
import ShoppingBasket from "@lucide/astro/icons/shopping-basket";
import Bot from "@lucide/astro/icons/bot";
import ListChecks from "@lucide/astro/icons/list-checks";
import Euro from "@lucide/astro/icons/euro";
import ShieldCheck from "@lucide/astro/icons/shield-check";
import CircleOff from "@lucide/astro/icons/circle-off";
import ToggleRight from "@lucide/astro/icons/toggle-right";
import RotateCcw from "@lucide/astro/icons/rotate-ccw";
import QrCode from "@lucide/astro/icons/qr-code";
import Printer from "@lucide/astro/icons/printer";
import FileText from "@lucide/astro/icons/file-text";
import Palette from "@lucide/astro/icons/palette";
import Pencil from "@lucide/astro/icons/pencil";
import Camera from "@lucide/astro/icons/camera";
import ChartColumn from "@lucide/astro/icons/chart-column";
import Section from "../Section.astro";
import { getDictionary, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}
const t = getDictionary(Astro.props.lang);

/** Icons and colours per group, in the order of t.features.groups (guests, AI waiter, service, brand). */
const looks = [
  {
    icons: [Languages, Type, BookOpen, Funnel, ShoppingBasket],
    card: "bg-herb-50",
    badge: "bg-herb-100 text-herb-800",
  },
  {
    icons: [Bot, ListChecks, Euro, ShieldCheck, CircleOff],
    card: "bg-mustard-50",
    badge: "bg-mustard-100 text-mustard-800",
  },
  {
    icons: [ToggleRight, RotateCcw, QrCode, Printer],
    card: "bg-paprika-50",
    badge: "bg-paprika-100 text-paprika-800",
  },
  {
    icons: [FileText, Palette, Pencil, Camera, ChartColumn],
    card: "bg-oat-100",
    badge: "bg-oat-200 text-oat-900",
  },
] as const;
---

<Section
  id="features"
  eyebrow={t.features.eyebrow}
  title={t.features.title}
  intro={t.features.intro}
  class="bg-surface"
>
  <div class="mt-12 grid gap-6 lg:grid-cols-2">
    {t.features.groups.map((group, g) => {
      const look = looks[g]!;
      return (
        <div class:list={["rounded-card p-6 sm:p-8", look.card]}>
          <h3 class="text-2xl font-semibold">{group.title}</h3>
          <p class="mt-1 mb-6 text-ink-muted">{group.intro}</p>
          <ul class="space-y-5">
            {group.items.map((item, i) => {
              const Icon = look.icons[i]!;
              return (
                <li class="flex gap-4">
                  <span
                    class:list={[
                      "grid size-10 shrink-0 place-items-center rounded-full",
                      look.badge,
                    ]}
                  >
                    <Icon class="size-5" aria-hidden="true" />
                  </span>
                  <div>
                    <p class="font-semibold">{item.title}</p>
                    <p class="mt-0.5 text-ink-muted">{item.text}</p>
                  </div>
                </li>
              );
            })}
          </ul>
        </div>
      );
    })}
  </div>
</Section>

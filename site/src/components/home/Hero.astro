---
import ArrowRight from "@lucide/astro/icons/arrow-right";
import Sparkles from "@lucide/astro/icons/sparkles";
import PhoneFrame from "../phone/PhoneFrame.astro";
import MenuScreen from "../phone/MenuScreen.astro";
import { guestUi } from "../../data/sample-menu";
import { getDictionary, localePath, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getDictionary(lang);
const chat = guestUi.en;
---

<section class="relative overflow-hidden px-4 pt-12 pb-20 sm:pt-20 sm:pb-28">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-40 -right-40 size-[38rem] rounded-full bg-[radial-gradient(circle,var(--color-paprika-100),transparent_65%)]"
  ></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-48 -left-32 size-[30rem] rounded-full bg-[radial-gradient(circle,var(--color-mustard-100),transparent_65%)]"
  ></div>

  <div class="relative mx-auto grid max-w-6xl items-center gap-14 lg:grid-cols-[1.15fr_0.85fr]">
    <div>
      <p class="eyebrow mb-4">{t.hero.eyebrow}</p>
      <h1 class="text-[2.6rem] leading-[1.05] font-semibold sm:text-6xl lg:text-7xl">
        {t.hero.title}
      </h1>
      <p class="mt-6 max-w-xl text-lg text-ink-muted sm:text-xl">
        {t.hero.subtitle}
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href={localePath(lang, "/demo")}
          data-cta="hero"
          class="btn-primary text-lg"
        >
          {t.hero.ctaPrimary}
          <ArrowRight class="size-5" aria-hidden="true" />
        </a>
        <a href="#demo" data-cta="hero-demo" class="btn-secondary text-lg">
          {t.hero.ctaSecondary}
        </a>
      </div>
      <p class="mt-6 flex items-center gap-2 text-[15px] font-medium text-herb-700">
        <Sparkles class="size-4 shrink-0" aria-hidden="true" />
        {t.hero.note}
      </p>
    </div>

    <div class="relative mx-auto w-full max-w-[19rem]">
      <PhoneFrame label={t.hero.phoneLabel} class="rotate-2">
        <MenuScreen lang="en" categories={[1]} />
      </PhoneFrame>
      <div
        aria-hidden="true"
        class="absolute bottom-16 -left-8 hidden w-60 -rotate-3 space-y-2 rounded-card bg-surface p-3 text-sm shadow-card sm:block lg:-left-24"
      >
        <p class="ml-auto w-fit rounded-2xl rounded-br-sm bg-herb-700 px-3 py-2 text-white">
          {chat.question}
        </p>
        <p class="w-fit rounded-2xl rounded-bl-sm bg-oat-100 px-3 py-2 text-ink">
          {chat.answer}
        </p>
      </div>
    </div>
  </div>
</section>

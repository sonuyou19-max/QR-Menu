---
// "Try with your own menu" (CLAUDE.md 4.6, Demo B): photos of the owner's own menu, translated
// into a preview in a phone frame. The island talks to the demo-translate edge function.
import TryYourMenuForm from "../forms/TryYourMenu";
import { siteConfig } from "../../data/site";
import { getDictionary, localePath, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getDictionary(lang);
---

<section
  id="try-your-menu"
  aria-labelledby="try-title"
  class="bg-oat-50 px-4 py-20 sm:py-28"
>
  <div class="mx-auto max-w-6xl">
    <div class="max-w-2xl">
      <p class="eyebrow mb-3">{t.tryMenu.eyebrow}</p>
      <h2 id="try-title" class="text-3xl font-semibold sm:text-5xl">
        {t.tryMenu.title}
      </h2>
      <p class="mt-5 text-lg text-ink-muted">{t.tryMenu.text}</p>
    </div>
    <div class="mt-10">
      <TryYourMenuForm
        client:visible
        lang={lang}
        t={t.tryMenu}
        endpoint={siteConfig.demoTranslateUrl}
        siteKey={siteConfig.turnstileSiteKey}
        demoHref={localePath(lang, "/demo")}
      />
    </div>
  </div>
</section>

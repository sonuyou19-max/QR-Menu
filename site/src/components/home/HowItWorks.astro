---
import Upload from "@lucide/astro/icons/upload";
import ListChecks from "@lucide/astro/icons/list-checks";
import QrCode from "@lucide/astro/icons/qr-code";
import Section from "../Section.astro";
import { getDictionary, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}
const t = getDictionary(Astro.props.lang);
const icons = [Upload, ListChecks, QrCode];
---

<Section id="how" eyebrow={t.how.eyebrow} title={t.how.title}>
  <ol class="mt-12 grid gap-6 md:grid-cols-3">
    {t.how.steps.map((step, i) => {
      const Icon = icons[i]!;
      return (
        <li class="relative rounded-card bg-surface p-7 shadow-card">
          <div class="mb-6 flex items-center justify-between">
            <span class="font-display text-6xl leading-none font-semibold text-paprika-200">
              {i + 1}
            </span>
            <span class="grid size-12 place-items-center rounded-full bg-brand text-on-brand">
              <Icon class="size-6" aria-hidden="true" />
            </span>
          </div>
          <h3 class="text-2xl font-semibold">{step.title}</h3>
          <p class="mt-2 text-ink-muted">{step.text}</p>
        </li>
      );
    })}
  </ol>
</Section>

---
import ArrowRight from "@lucide/astro/icons/arrow-right";
import { getDictionary, localePath, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getDictionary(lang);
---

<section aria-labelledby="final-cta-title" class="px-4 pb-20 sm:pb-28">
  <div class="mx-auto max-w-6xl rounded-card bg-brand px-6 py-14 text-center text-on-brand sm:px-12 sm:py-20">
    <h2
      id="final-cta-title"
      class="mx-auto max-w-2xl text-3xl font-semibold sm:text-5xl"
    >
      {t.finalCta.title}
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-lg text-paprika-50">
      {t.finalCta.text}
    </p>
    <a
      href={localePath(lang, "/demo")}
      data-cta="final"
      class="btn mt-8 bg-surface text-lg text-brand-strong hover:bg-oat-100"
    >
      {t.finalCta.cta}
      <ArrowRight class="size-5" aria-hidden="true" />
    </a>
  </div>
</section>

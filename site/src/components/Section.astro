---
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  intro?: string;
  class?: string;
  /** Centre the heading block (default: left-aligned). */
  center?: boolean;
}
const {
  id,
  eyebrow,
  title,
  intro,
  class: className,
  center = false,
} = Astro.props;
const headingId = id ? `${id}-title` : undefined;
---

<section
  id={id}
  aria-labelledby={headingId}
  class:list={["px-4 py-20 sm:py-28", className]}
>
  <div class="mx-auto max-w-6xl">
    <div class:list={["max-w-2xl", center && "mx-auto text-center"]}>
      {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
      <h2 id={headingId} class="text-3xl font-semibold sm:text-5xl">
        {title}
      </h2>
      {intro && <p class="mt-4 text-lg text-ink-muted">{intro}</p>}
    </div>
    <slot />
  </div>
</section>

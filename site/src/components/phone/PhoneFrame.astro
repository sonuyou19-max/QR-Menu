---
// Phone frame. Static mockups pass `label` and are exposed to screen readers as one image;
// interactive content (the demo island) omits it and stays fully accessible.
interface Props {
  label?: string;
  class?: string;
  /** "onDark" lightens the bezel so it stays visible on dark sections. */
  tone?: "onLight" | "onDark";
}
const { label, class: className, tone = "onLight" } = Astro.props;
const bezel =
  tone === "onDark" ? "border-oat-600 bg-oat-600" : "border-oat-900 bg-oat-900";
---

<div
  role={label ? "img" : undefined}
  aria-label={label}
  class:list={[
    "rounded-phone shadow-phone relative aspect-[9/19] w-full overflow-hidden border-[10px]",
    bezel,
    className,
  ]}
>
  <div
    class:list={[
      "absolute top-1.5 left-1/2 z-10 h-5 w-20 -translate-x-1/2 rounded-full",
      bezel,
    ]}
  ></div>
  <div class="absolute inset-0 overflow-hidden rounded-[2rem] bg-surface">
    <slot />
  </div>
</div>

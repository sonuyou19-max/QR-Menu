---
// Static "Show to staff" screen (CLAUDE.md 4.3): original dish names large, guest-language name small.
import { guestUi, sampleMenu, type GuestLang } from "../../data/sample-menu";
import { guestPrice } from "./format";

interface Props {
  lang?: GuestLang;
}
const { lang = "en" } = Astro.props;
const ui = guestUi[lang];

const find = (name: string) =>
  sampleMenu.flatMap((c) => c.items).find((i) => i.name === name)!;
const lines = [
  { item: find("Stoofvlees met frietjes"), qty: 2, note: "" },
  {
    item: find("Dame blanche"),
    qty: 2,
    note: lang === "en" ? "no whipped cream" : "",
  },
];
const total = lines.reduce((sum, l) => sum + l.qty * l.item.price, 0);
---

<div class="flex h-full flex-col bg-oat-950 px-4 pt-9 pb-5 text-white">
  <p class="text-[12px] font-semibold tracking-wide text-mustard-300 uppercase">
    {ui.showToStaff}
  </p>
  <p class="font-display text-3xl font-semibold">{ui.table} 5</p>
  <ul class="mt-4 flex-1 space-y-3.5">
    {lines.map(({ item, qty, note }) => (
      <li class="flex gap-3 border-b border-white/15 pb-3">
        <span class="font-display text-2xl leading-none font-semibold text-mustard-300">
          {qty}×
        </span>
        <div class="min-w-0 flex-1">
          <p class="font-display text-[17px] leading-tight font-semibold">
            {item.name}
          </p>
          <p class="text-[11px] text-oat-300">{item.tr[lang].name}</p>
          {note && (
            <p class="mt-0.5 text-[12px] text-mustard-200 italic">“{note}”</p>
          )}
        </div>
        <span class="text-[13px] font-semibold">
          {guestPrice(lang, qty * item.price)}
        </span>
      </li>
    ))}
  </ul>
  <div class="flex items-baseline justify-between border-t-2 border-white pt-3">
    <span class="text-[13px] font-semibold uppercase">{ui.total}</span>
    <span class="font-display text-2xl font-semibold">
      {guestPrice(lang, total)}
    </span>
  </div>
</div>

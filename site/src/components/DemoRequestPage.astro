---
// Placeholder until the booking form lands in Phase 0.4.
import ArrowLeft from "@lucide/astro/icons/arrow-left";
import Base from "../layouts/Base.astro";
import { getDictionary, localePath, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getDictionary(lang);
---

<Base
  lang={lang}
  path="/demo"
  title={t.demoPage.metaTitle}
  description={t.demoPage.metaDescription}
  noindex
>
  <div class="mx-auto max-w-2xl px-4 py-24">
    <h1 class="text-4xl font-semibold sm:text-6xl">{t.demoPage.title}</h1>
    <p class="mt-6 text-lg text-ink-muted">{t.demoPage.text}</p>
    <a href={localePath(lang, "/")} class="btn-secondary mt-8">
      <ArrowLeft class="size-5" aria-hidden="true" />
      {t.demoPage.back}
    </a>
  </div>
</Base>

---
// "Book a demo" page (CLAUDE.md 4.6): what to expect + the booking form island.
import Check from "@lucide/astro/icons/check";
import Base from "../layouts/Base.astro";
import BookDemoForm from "./forms/BookDemoForm";
import { siteConfig } from "../data/site";
import { getDictionary, localePath, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getDictionary(lang);
---

<Base
  lang={lang}
  path="/demo"
  title={t.demoPage.metaTitle}
  description={t.demoPage.metaDescription}
>
  <section class="px-4 py-14 sm:py-20">
    <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
      <div>
        <h1 class="text-4xl font-semibold sm:text-6xl">{t.demoPage.title}</h1>
        <p class="mt-5 text-lg text-ink-muted">{t.demoPage.intro}</p>
        <h2 class="mt-10 font-sans text-base font-semibold">
          {t.demoPage.expectTitle}
        </h2>
        <ul class="mt-4 space-y-3">
          {t.demoPage.expect.map((item) => (
            <li class="flex gap-3">
              <Check
                class="mt-0.5 size-5 shrink-0 text-success"
                aria-hidden="true"
              />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="relative rounded-card bg-surface p-5 shadow-card sm:p-8">
        <BookDemoForm
          client:load
          lang={lang}
          t={t.form}
          privacyHref={localePath(lang, "/privacy")}
          endpoint={siteConfig.bookDemoUrl}
          siteKey={siteConfig.turnstileSiteKey}
          contactEmail={siteConfig.contactEmail}
        />
      </div>
    </div>
  </section>
</Base>

---
// Full-screen sample menu, opened from the QR code or the "full screen" button on the home page.
import ArrowLeft from "@lucide/astro/icons/arrow-left";
import Base from "../layouts/Base.astro";
import DemoPhone from "./demo/DemoPhone";
import { getDictionary, localePath, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getDictionary(lang);
---

<Base
  lang={lang}
  path="/menu-demo"
  title={t.menuDemoPage.metaTitle}
  description={t.menuDemoPage.metaDescription}
  noindex
  bare
>
  <div class="flex h-dvh flex-col bg-oat-950">
    <nav
      aria-label={t.nav.main}
      class="flex items-center gap-3 px-4 pt-[max(0.5rem,env(safe-area-inset-top))] pb-2 text-sm text-oat-50"
    >
      <a
        href={localePath(lang, "/#demo")}
        class="flex min-h-10 items-center gap-1.5 font-semibold"
      >
        <ArrowLeft class="size-4" aria-hidden="true" />
        MenuBuddy
      </a>
      <span class="rounded-full bg-mustard-400 px-2 py-0.5 text-xs font-semibold text-oat-950">
        {t.menuDemoPage.badge}
      </span>
      <a
        href={localePath(lang, "/demo")}
        data-cta="menu-demo"
        class="btn-primary ml-auto min-h-10 px-4 py-2 text-sm"
      >
        {t.menuDemoPage.cta}
      </a>
    </nav>
    <main id="main" class="min-h-0 flex-1">
      <DemoPhone client:load label={t.demo.phoneLabel} fullscreen />
    </main>
  </div>
</Base>

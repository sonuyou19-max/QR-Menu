---
import "../styles/global.css";
import { themeColor } from "@menubuddy/design-tokens";
import frauncesLatin from "@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url";
import dmSansLatin from "@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../data/site";
import {
  defaultLang,
  languages,
  localePath,
  locales,
  ogLocales,
  type Lang,
} from "../i18n";

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** Page path without language prefix, e.g. "/" or "/demo". */
  path: string;
  noindex?: boolean;
  /** No site header/footer (full-screen pages such as the menu demo). */
  bare?: boolean;
}
const {
  title,
  description,
  lang,
  path,
  noindex: pageNoindex = false,
  bare = false,
} = Astro.props;
// Test deployments (e.g. *.workers.dev) set PUBLIC_SITE_NOINDEX=true so they stay out of search.
const noindex = pageNoindex || import.meta.env.PUBLIC_SITE_NOINDEX === "true";

const site = Astro.site!;
const canonical = new URL(localePath(lang, path), site).href;
const ogImage = new URL(`/og/${lang}.png`, site).href;
---

<!doctype html>
<html lang={locales[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        {languages.map((l) => (
          <link
            rel="alternate"
            hreflang={locales[l]}
            href={new URL(localePath(l, path), site).href}
          />
        ))}
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(localePath(defaultLang, path), site).href}
        />
      </>
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Brisolo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocales[lang]} />
    {languages
      .filter((l) => l !== lang)
      .map((l) => (
        <meta property="og:locale:alternate" content={ogLocales[l]} />
      ))}
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content={themeColor} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href={frauncesLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={dmSansLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body class="min-h-dvh">
    {bare ? (
      <slot />
    ) : (
      <>
        <Header lang={lang} path={path} />
        <main id="main">
          <slot />
        </main>
        <Footer lang={lang} path={path} />
      </>
    )}
    <script
      is:inline
      define:vars={{
        trackUrl: `${siteConfig.supabaseUrl}/rest/v1/rpc/track_site_event`,
        trackKey: siteConfig.supabaseKey,
        trackLang: lang,
      }}
    >
      // Counts clicks on buttons marked data-cta (shown in Brisolo HQ). Cookie-free: only the
      // button's name and the page language are sent, and only on the real domain.
      if (/(^|\.)brisolo\.be$/.test(location.hostname)) {
        document.addEventListener("click", (e) => {
          const el =
            e.target instanceof Element && e.target.closest("[data-cta]");
          if (!el) return;
          try {
            fetch(trackUrl, {
              method: "POST",
              keepalive: true,
              headers: { apikey: trackKey, "Content-Type": "application/json" },
              body: JSON.stringify({
                p_label: el.dataset.cta,
                p_lang: trackLang,
              }),
            }).catch(() => {});
          } catch {}
        });
      }
    </script>
  </body>
</html>

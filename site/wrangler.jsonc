// Cloudflare Worker serving the marketing site (static files only, no Worker code).
// Deployed by Workers Builds from the repo root: build `npm run build:site`,
// deploy `npx wrangler deploy --config site/wrangler.jsonc`. Served on brisolo.be (www too) and
// on the workers.dev test address.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "menubuddy-site",
  "compatibility_date": "2026-10-01",
  // Keep the workers.dev test address too (routes switch it off by default).
  "workers_dev": true,
  "routes": [
    { "pattern": "brisolo.be", "custom_domain": true },
    { "pattern": "www.brisolo.be", "custom_domain": true },
  ],
  "assets": {
    "directory": "./dist",
    // Astro writes pages as /fr/index.html etc.; serve them at /fr/ and show our 404 page otherwise.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
}
